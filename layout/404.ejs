<section class="notfound">
	<p class="notfound-code" aria-hidden="true">404</p>
	<h1 class="notfound-title"><%= page.title || '页面不存在' %></h1>
	<% if (page.content && page.content.trim()) { %>
		<div class="rich notfound-body"><%- page.content %></div>
	<% } else { %>
		<p class="notfound-body">这个地址没有对应的页面。</p>
	<% } %>
	<a class="btn btn-accent" href="<%- url_for('/') %>">
		<i class="fa fa-home" aria-hidden="true"></i> 回到首页
	</a>
</section>
