<article class="page-card">
	<header class="page-head">
		<p class="page-kicker">页面</p>
		<h1 class="page-title"><%= page.title %></h1>
		<% if (page.description) { %>
			<p class="page-desc"><%= page.description %></p>
		<% } %>
	</header>

	<% if (page.content && page.content.trim()) { %>
		<div class="rich page-body">
			<%- page.content %>
		</div>
	<% } %>
</article>
