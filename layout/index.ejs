<%
	/* 首页 = hero 幻灯片 + 最新文章的信息流 + 右侧 side-card。
	   分类条是真实分类页入口，不做「只过滤当前页」的假筛选；
	   网格/列表是纯展示偏好，由 js/fluent.js 记忆。 */
	var homeCfg = theme.home || {};
	var allPosts = (page.posts || site.posts).sort('-date').toArray();
	var cap = parseInt(theme.recent_count, 10);
	if (!(cap > 0)) cap = 10;
	var visible = allPosts.slice(0, cap);
	var sideCats = site.categories.sort('-length').limit(8);
	var view = homeCfg.view === 'list' ? 'list' : 'grid';
	var hiddenCount = Math.max(0, allPosts.length - cap);
	/* side-card 只属于首页；分类/标签页在本阶段仍复用 index 模板，
	   不给它们塞首页侧栏。 */
	var showSide = is_home();

	var calCfg = theme.calendar || {};
	var calWidget = calCfg.enable !== false && calCfg.widget !== false;
	var calPrompt = calCfg.enable !== false && calCfg.prompt !== false;

	var cmCfg = theme.comments || {};
	var memosCfg = theme.memos || {};
	var memosHomeOn = memosCfg.enable !== false && memosCfg.home !== false &&
		cmCfg.enable !== false && !!cmCfg.env_id;

	/* ---------- 首页 hero ----------
	   home.hero.slides 是有序数组，每项一页；page 可显式指定页码。
	   type: cover（封面文案）| latest（最新发布）| category（某分类最新）
	         | onthisday（往年今天的文章）| custom（自定义文案/图片/按钮） */
	var heroCfg = homeCfg.hero || {};
	var heroProfile = theme.profile || {};
	var heroOn = is_home() && (page.current || 1) === 1 && heroCfg.enable !== false;
	var heroEyebrow = heroCfg.eyebrow || (theme.title + (config.subtitle ? ' · ' + config.subtitle : ''));
	var heroTitle = heroCfg.title || theme.description || config.description || theme.title;
	var heroSlogan = heroCfg.slogan || heroProfile.motto || config.description || '';
	var heroDim = (heroCfg.dim === undefined || heroCfg.dim === null) ? 0.52 : heroCfg.dim;

	function heroBtns(list, fallback) {
		var src = (list && list.length) ? list : (fallback || []);
		var out = [];
		src.forEach(function (b) {
			if (!b) return;
			if (typeof b === 'string') { out.push({ text: '阅读全文', url: b, accent: true }); return; }
			out.push({ text: b.text || '查看', url: b.url || '#', accent: b.accent !== false });
		});
		return out;
	}

	function heroPostSlide(p, eyebrow) {
		var t = p.title || '';
		if (t.length > 36) t = t.slice(0, 36) + '…';
		return {
			eyebrow: eyebrow,
			title: t,
			text: fluent_digest(p, 150),
			buttons: [{ text: '阅读全文', url: url_for(p.path), accent: true }]
		};
	}

	var heroSlides = [];
	var usedPages = {};
	var pageCursor = 1;
	function takePage(hint) {
		var p = parseInt(hint, 10);
		if (p > 0 && !usedPages[p]) { usedPages[p] = 1; return p; }
		while (usedPages[pageCursor]) pageCursor++;
		usedPages[pageCursor] = 1;
		return pageCursor++;
	}
	function addHeroSlide(slide, hint) {
		slide.page = takePage(hint);
		heroSlides.push(slide);
	}

	var heroDefs = heroCfg.slides;
	if (!heroDefs || !heroDefs.length) {
		/* 兼容旧配置：pages = 总页数，第 1 页封面，其余页各取一篇最新文章 */
		var heroPages = parseInt(heroCfg.pages, 10);
		if (!(heroPages > 0)) heroPages = 2;
		heroDefs = [{ type: 'cover', page: 1 }];
		if (heroPages > 1) {
			heroDefs.push({ type: 'latest', page: 2, count: heroPages - 1 });
		}
	}

	heroDefs.forEach(function (def) {
		def = def || {};
		var type = def.type || 'cover';
		var pool = allPosts;
		var eyebrow = def.eyebrow || '';

		if (def.category) {
			var catObj = site.categories.findOne({ name: def.category });
			pool = catObj ? catObj.posts.sort('-date').toArray() : [];
			if (!eyebrow) eyebrow = (def.label || def.category) + ' · 最新';
		}

		if (type === 'latest' || type === 'category') {
			var n = Math.max(1, parseInt(def.count, 10) || 1);
			var skip = Math.max(0, parseInt(def.skip, 10) || 0);
			if (!eyebrow) eyebrow = '最新发布';
			pool.slice(skip, skip + n).forEach(function (p, i) {
				addHeroSlide(heroPostSlide(p, eyebrow), i === 0 ? def.page : 0);
			});
			return;
		}

		if (type === 'onthisday') {
			var md = date(Date.now(), 'MM-DD');
			var thisYear = date(Date.now(), 'YYYY');
			var hist = allPosts.filter(function (p) {
				return date(p.date, 'YYYY') !== thisYear && date(p.date, 'MM-DD') === md;
			});
			var hn = Math.max(1, parseInt(def.count, 10) || 3);
			if (!eyebrow) eyebrow = '历史上的今天';
			hist.slice(0, hn).forEach(function (p, i) {
				addHeroSlide(heroPostSlide(p, eyebrow), i === 0 ? def.page : 0);
			});
			return;
		}

		if (type === 'custom') {
			addHeroSlide({
				eyebrow: eyebrow,
				title: def.title || heroTitle,
				text: def.text || def.slogan || '',
				image: def.image || '',
				dim: (def.dim === undefined || def.dim === null) ? heroDim : def.dim,
				buttons: heroBtns(def.buttons)
			}, def.page);
			return;
		}

		/* cover：顶层 home.hero 的文案作为默认值 */
		addHeroSlide({
			eyebrow: eyebrow || heroEyebrow,
			title: def.title || heroTitle,
			text: (def.text === undefined ? heroSlogan : def.text),
			image: (def.image === undefined ? (heroCfg.image || '') : def.image),
			dim: (def.dim === undefined || def.dim === null) ? heroDim : def.dim,
			buttons: heroBtns(def.buttons, [
				{ text: '开始阅读', url: '#post-list', accent: true },
				{ text: '关于我', url: url_for('/about'), accent: false }
			])
		}, def.page);
	});

	heroSlides.sort(function (a, b) { return a.page - b.page; });
	if (!heroOn) heroSlides = [];
	var heroSlideCount = heroSlides.length;
%>

<div class="home-layout<%= showSide ? '' : ' no-side' %>">
	<div class="home-main">
		<% if (heroOn && heroSlideCount) { %>
			<section class="home-hero hero-slider" data-hero-slider
				aria-roledescription="carousel" aria-label="首页展示">
				<div class="hero-inner">
					<div class="hero-slides">
						<% heroSlides.forEach(function (s, si) { %>
							<div class="hero-slide<%= si === 0 ? ' is-active' : '' %><%= s.image ? ' has-image' : '' %>"
								data-hero-slide aria-hidden="<%= si === 0 ? 'false' : 'true' %>"
								<% if (s.image) { %>style="--hero-image:url('<%- url_for(s.image) %>');--hero-dim:<%= s.dim %>;"<% } %>>
								<div class="hero-copy">
									<% if (s.eyebrow) { %>
										<p class="hero-month"><%= s.eyebrow %></p>
									<% } %>
									<% if (si === 0) { %>
										<h1 class="hero-title" id="hero-title"><%= s.title %></h1>
									<% } else { %>
										<h2 class="hero-title"><%= s.title %></h2>
									<% } %>
									<% if (s.text) { %>
										<p class="hero-slogan"><%= s.text %></p>
									<% } %>
									<% if (s.buttons && s.buttons.length) { %>
										<div class="hero-actions">
											<% s.buttons.forEach(function (b) { %>
												<a class="btn<%= b.accent ? ' btn-accent' : '' %>" href="<%- b.url %>"><%= b.text %></a>
											<% }) %>
										</div>
									<% } %>
								</div>
							</div>
						<% }) %>
					</div>
				</div>

				<% if (heroSlideCount > 1) { %>
					<div class="hero-controls">
						<button class="hero-nav" type="button" data-hero-prev aria-label="上一页">&lt;</button>
						<div class="hero-dots" role="group" aria-label="幻灯片页码">
							<% for (var hi = 0; hi < heroSlideCount; hi++) { %>
								<button class="hero-dot<%= hi === 0 ? ' is-active' : '' %>" type="button" data-hero-to="<%= hi %>"
									aria-label="第 <%= hi + 1 %> 页"<%= hi === 0 ? ' aria-current="true"' : '' %>><%= hi + 1 %></button>
							<% } %>
						</div>
						<button class="hero-nav" type="button" data-hero-next aria-label="下一页">&gt;</button>
					</div>
				<% } %>
			</section>
		<% } %>

		<% if (calWidget || calPrompt) { %>
			<%- include('_partial/calendar-data') %>
		<% } %>
		<% if (calPrompt) { %>
			<%- include('_partial/calendar-prompt') %>
		<% } %>

		<div class="feed-toolbar">
			<nav class="chips" aria-label="按分类浏览">
				<a class="chip is-active" href="<%- url_for('/') %>">全部</a>
				<% sideCats.forEach(function (cat) { %>
					<a class="chip" href="<%- url_for(cat.path) %>"><%= cat.name %><sup><%= cat.length %></sup></a>
				<% }) %>
			</nav>

			<div class="view-seg" role="group" aria-label="列表视图">
				<button class="seg-btn<%= view === 'grid' ? ' is-active' : '' %>" type="button"
					data-view="grid" aria-label="网格视图" title="网格视图" aria-pressed="<%= view === 'grid' %>">
					<i class="fa fa-th-large" aria-hidden="true"></i>
				</button>
				<button class="seg-btn<%= view === 'list' ? ' is-active' : '' %>" type="button"
					data-view="list" aria-label="列表视图" title="列表视图" aria-pressed="<%= view === 'list' %>">
					<i class="fa fa-bars" aria-hidden="true"></i>
				</button>
			</div>
		</div>

		<% if (!allPosts.length) { %>
			<div class="empty-state">
				<i class="fa fa-inbox" aria-hidden="true"></i>
				<p>还没有发布任何文章。</p>
			</div>
		<% } else { %>
			<div class="section-head">
				<h2 class="section-title">最新文章</h2>
				<a class="section-more" href="<%- url_for('/archives') %>">
					全部 <%= allPosts.length %> 篇
				</a>
			</div>

			<div class="post-list<%= view === 'list' ? ' list-view' : '' %>" id="post-list">
				<% visible.forEach(function (p) { %>
					<%- include('_partial/post-card', { post: p }) %>
				<% }) %>
			</div>

			<% if (!visible.length) { %>
				<div class="empty-state">
					<p>没有更多文章了，去 <a href="<%- url_for('/archives') %>">归档</a> 看看。</p>
				</div>
			<% } %>

			<%- include('_partial/pagination') %>

			<% if (hiddenCount > 0) { %>
				<a class="home-more" href="<%- url_for('/archives') %>">
					查看更早的 <%= hiddenCount %> 篇文章
				</a>
			<% } %>
		<% } %>
	</div>

	<% if (showSide) { %>
		<aside class="home-side" aria-label="首页侧栏">
			<%- include('_partial/side-card') %>
			<% if (calWidget) { %>
				<%- include('_partial/calendar') %>
			<% } %>
			<% if (memosHomeOn) { %>
				<%- include('_partial/memos-recent') %>
			<% } %>
		</aside>
	<% } %>
</div>

<% if (memosHomeOn) { %>
<script type="application/json" id="memos-config"><%-
	JSON.stringify({
		envId: cmCfg.env_id,
		path: memosCfg.path || '/shuoshuo/',
		recentCount: memosCfg.recent_count || 3,
		ownerNick: memosCfg.owner_nick || ''
	}).replace(/</g, '\\u003c')
%></script>
<% } %>
<% if (calWidget || calPrompt) { %>
	<%- js('js/calendar.js') %>
<% } %>
<% if (heroSlideCount > 1) { %>
	<%- js('js/hero-slider.js') %>
<% } %>
